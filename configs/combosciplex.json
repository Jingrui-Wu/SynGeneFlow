{
  "dataset": "combosciplex",
  "training": "python -m syngeneflow.train",
  "args": {
    "split": "drug",
    "n_genes": 5000,
    "gene_list": "resources/combosciplex_reference_gene_order.txt",
    "gene_subset": 256,
    "hidden": 128,
    "heads": 4,
    "gene_layers": 2,
    "velocity_layers": 4,
    "graph_topk": 30,
    "batch_size": 16,
    "train_steps": 100000,
    "seed": 42
  },
  "note": "Condition names, dose handling and split semantics must match the actual drug dataset."
}
